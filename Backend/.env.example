# Application
PROJECT_NAME="Yatzar Operations API"
API_V1_PREFIX="/api/v1"
DEBUG=True

# Server
HOST=127.0.0.1
PORT=8000

# Database
# Must use the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/yatzar_operation
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5433/yatzar_operation
# Initial Super Admin account
DEFAULT_SUPER_ADMIN_USERNAME="superadmin"
DEFAULT_SUPER_ADMIN_EMAIL="admin@yatzar.com"
DEFAULT_SUPER_ADMIN_PASSWORD="replace-this-before-deployment"

# Authentication
# Use a long random value in non-local environments.
SESSION_SECRET="replace-with-a-long-random-secret"
SESSION_COOKIE_NAME="yatzar_session"
SESSION_MAX_AGE=28800

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=test@gmail.com
MAIL_PASSWORD=padskaskldmasklmdaskldmlsam
MAIL_ENCRYPTION=TLS
MAIL_FROM_ADDRESS=test@gmail.com
MAIL_FROM_NAME="Yatzar Asset"
MAIL_TIMEOUT=30
MAIL_WORKER_ENABLED=true
MAIL_POLL_SECONDS=30
MAIL_MAX_ATTEMPTS=5
MAIL_TIMEZONE=Asia/Kolkata
EMAIL_TRACKING_BASE_URL=http://localhost:8000/api/v1/email-marketing
EMAIL_TRACKING_SECRET=

# Comma-separated browser origins allowed to send the session cookie.
FRONTEND_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"


PUBLIC_API_URL=http://localhost:8000/api/v1
FRONTEND_URL=http://localhost:5173
